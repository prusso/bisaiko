#!/usr/bin/env bash

set -u

app_id="org.omarchy.bisaiko"
runtime_root="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="${runtime_root}/bisaiko-${UID}"
lock_file="${state_dir}/lock"
pid_file="${state_dir}/pid"
token_file="${state_dir}/token"
pinned_file="${state_dir}/pinned"
hover_file="${state_dir}/hover"
workspace_file="${state_dir}/workspace"
self_path="$(readlink -f "$0")"

mkdir -p -m 700 "$state_dir"

read_state() {
  local path="$1"
  local fallback="$2"
  if [[ -r "$path" ]]; then
    IFS= read -r state_value < "$path"
    printf '%s' "${state_value:-$fallback}"
  else
    printf '%s' "$fallback"
  fi
}

write_state() {
  printf '%s\n' "$2" > "$1"
}

client_json() {
  hyprctl clients -j 2>/dev/null |
    jq -c --arg app_id "$app_id" '[.[] | select(.class == $app_id or .initialClass == $app_id)] | first // empty' 2>/dev/null
}

special_workspace() {
  hyprctl monitors -j 2>/dev/null |
    jq -r '[.[] | select(.focused == true)][0].specialWorkspace.name // ""' 2>/dev/null
}

active_workspace() {
  hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null
}

close_popup() {
  local client address popup_pid
  client="$(client_json)"
  address="$(jq -r '.address // empty' <<< "$client" 2>/dev/null)"

  popup_pid=""
  if [[ -r "$pid_file" ]]; then
    popup_pid="$(read_state "$pid_file" "")"
  fi

  if [[ -n "$address" ]]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:${address}\" })" >/dev/null 2>&1 || true
  fi

  if [[ "$popup_pid" =~ ^[0-9]+$ ]] && kill -0 "$popup_pid" 2>/dev/null; then
    for _ in {1..3}; do
      sleep 0.1
      kill -0 "$popup_pid" 2>/dev/null || break
    done
  fi

  if [[ "$popup_pid" =~ ^[0-9]+$ ]] && kill -0 "$popup_pid" 2>/dev/null; then
    kill -TERM -- "-${popup_pid}" 2>/dev/null || kill -TERM "$popup_pid" 2>/dev/null || true
  fi

  rm -f "$pid_file" "$token_file" "$pinned_file" "$hover_file" "$workspace_file"
}

position_popup() {
  local client="$1"
  local address width cursor_json cursor_x monitor_json monitor_x monitor_y monitor_width monitor_scale monitor_top
  local desired_x desired_y min_x max_x

  address="$(jq -r '.address' <<< "$client")"
  width="$(jq -r '.size[0]' <<< "$client")"
  cursor_json="$(hyprctl cursorpos -j 2>/dev/null)"
  cursor_x="$(jq -r '.x // 0' <<< "$cursor_json")"
  monitor_json="$(hyprctl monitors -j 2>/dev/null | jq -c '[.[] | select(.focused == true)][0] // empty')"

  [[ -n "$monitor_json" ]] || return 0
  monitor_x="$(jq -r '.x' <<< "$monitor_json")"
  monitor_y="$(jq -r '.y' <<< "$monitor_json")"
  monitor_width="$(jq -r '.width' <<< "$monitor_json")"
  monitor_scale="$(jq -r '.scale' <<< "$monitor_json")"
  monitor_top="$(jq -r '.reserved[1] // 0' <<< "$monitor_json")"

  min_x=$((monitor_x + 8))
  max_x=$((monitor_x + monitor_width / monitor_scale - width - 8))
  desired_x=$((cursor_x - width / 2))
  (( desired_x < min_x )) && desired_x=$min_x
  (( desired_x > max_x )) && desired_x=$max_x
  desired_y=$((monitor_y + monitor_top + 8))

  hyprctl dispatch "hl.dsp.window.move({ x = ${desired_x}, y = ${desired_y}, window = \"address:${address}\" })" >/dev/null 2>&1 || true
}

open_popup() {
  local pin_mode="$1"
  local existing token popup_pid workspace

  existing="$(client_json)"
  if [[ -n "$existing" ]]; then
    return 0
  fi

  [[ -z "$(special_workspace)" ]] || return 0

  workspace="$(active_workspace)"
  token="${BASHPID}-${RANDOM}-$(date +%s%N)"
  write_state "$token_file" "$token"
  write_state "$pinned_file" "$pin_mode"
  write_state "$workspace_file" "$workspace"

  setsid foot --app-id="$app_id" --title="Bisaikō" --window-size-chars=80x24 btop 9>&- >/dev/null 2>&1 &
  popup_pid=$!
  write_state "$pid_file" "$popup_pid"

  setsid "$self_path" watch "$token" 9>&- >/dev/null 2>&1 &
}

watch_popup() {
  local expected_token="$1"
  local client="" address="" at_x=0 at_y=0 width=0 height=0
  local cursor_json cursor_x cursor_y current_workspace initial_workspace
  local outside_ticks=0 refresh_tick=0

  for _ in {1..30}; do
    [[ "$(read_state "$token_file" "")" == "$expected_token" ]] || return 0
    client="$(client_json)"
    [[ -n "$client" ]] && break
    sleep 0.1
  done

  if [[ -z "$client" ]]; then
    close_popup
    return 0
  fi

  position_popup "$client"
  initial_workspace="$(read_state "$workspace_file" "")"

  while [[ "$(read_state "$token_file" "")" == "$expected_token" ]]; do
    if (( refresh_tick == 0 )); then
      client="$(client_json)"
      [[ -n "$client" ]] || break
      address="$(jq -r '.address' <<< "$client")"
      at_x="$(jq -r '.at[0]' <<< "$client")"
      at_y="$(jq -r '.at[1]' <<< "$client")"
      width="$(jq -r '.size[0]' <<< "$client")"
      height="$(jq -r '.size[1]' <<< "$client")"
      current_workspace="$(active_workspace)"

      if [[ "$current_workspace" != "$initial_workspace" || -n "$(special_workspace)" ]]; then
        close_popup
        return 0
      fi
    fi
    refresh_tick=$(((refresh_tick + 1) % 5))

    if [[ "$(read_state "$pinned_file" "0")" == "1" || "$(read_state "$hover_file" "0")" == "1" ]]; then
      outside_ticks=0
      sleep 0.15
      continue
    fi

    cursor_json="$(hyprctl cursorpos -j 2>/dev/null)"
    cursor_x="$(jq -r '.x // -1' <<< "$cursor_json")"
    cursor_y="$(jq -r '.y // -1' <<< "$cursor_json")"

    if (( cursor_x >= at_x && cursor_x < at_x + width && cursor_y >= at_y && cursor_y < at_y + height )); then
      outside_ticks=0
    else
      outside_ticks=$((outside_ticks + 1))
      if (( outside_ticks >= 3 )); then
        close_popup
        return 0
      fi
    fi

    sleep 0.15
  done

  rm -f "$pid_file" "$token_file" "$pinned_file" "$hover_file" "$workspace_file"
}

action="${1:-status}"

case "$action" in
  enter)
    (
      flock -x 9
      write_state "$hover_file" "1"
      open_popup "0"
    ) 9>"$lock_file"
    ;;
  leave)
    (
      flock -x 9
      write_state "$hover_file" "0"
    ) 9>"$lock_file"
    ;;
  toggle)
    (
      flock -x 9
      if [[ -n "$(client_json)" ]]; then
        if [[ "$(read_state "$pinned_file" "0")" == "1" ]]; then
          close_popup
        else
          write_state "$pinned_file" "1"
        fi
      else
        open_popup "1"
      fi
    ) 9>"$lock_file"
    ;;
  close)
    (
      flock -x 9
      close_popup
    ) 9>"$lock_file"
    ;;
  watch)
    watch_popup "${2:-}"
    ;;
  status)
    if [[ -n "$(client_json)" ]]; then
      printf '%s\n' "$(read_state "$pinned_file" "0")"
    else
      printf 'closed\n'
    fi
    ;;
  *)
    printf 'Usage: %s {enter|leave|toggle|close|status}\n' "${0##*/}" >&2
    exit 2
    ;;
esac
